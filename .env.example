# Supabase — powers the /admin panel, live content, and the contact form.
# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API. See supabase/README.md for full setup.
#
# Both are PUBLIC by design (inlined into the static bundle at build time);
# Row Level Security is what protects the data. Re-run the build after editing.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
